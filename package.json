{
  "name": "leeromgeving-bml",
  "private": true,
  "description": "Statische leeromgeving: begrippen, flashcards en oefentoetsen per module. Geen build-stap; dit bestand is alleen voor tests en controles.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "check": "node tools/validate-data.js",
    "kwaliteit": "node tools/kwaliteit.js",
    "build": "node tools/build.js",
    "serve": "node tools/serve.js _site 4173",
    "bron": "node tools/serve.js . 4173",
    "e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "iconen": "node tools/maak-iconen.js",
    "ci": "npm test && npm run check && npm run build && npm run e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@resvg/resvg-js": "2.6.2"
  }
}
