{
  "name": "Leeromgeving BML",
  "short_name": "Leeromgeving",
  "description": "Begrippenlijst, flashcards en oefentoetsen per module",
  "lang": "nl",
  "start_url": "./#/vandaag",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f5f7f8",
  "theme_color": "#0b6e74",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Flashcards", "url": "./#/flashcards", "icons": [{ "src": "img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Oefentoets", "url": "./#/toets", "icons": [{ "src": "img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Begrippen zoeken", "url": "./#/begrippen", "icons": [{ "src": "img/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "text": "q" }
  }
}
